{
  "name": "wish-game",
  "version": "1.0.0",
  "description": "WISH — interactive 3D world of wishes",
  "main": "electron.js",
  "author": "WISH",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable zip"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.wish.world",
    "productName": "WISH",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "electron.js",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
