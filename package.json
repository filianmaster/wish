{
  "name": "wish-world",
  "version": "1.0.0",
  "description": "WISH — твой мир, твои правила",
  "main": "electron.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable zip"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.filianmaster.wish",
    "productName": "WISH",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "src/**/*",
      "electron.js",
      "package.json",
      "node_modules/three/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "WISH-${version}-${arch}.${ext}"
    }
  }
}